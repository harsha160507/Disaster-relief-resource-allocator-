# Runtime template only: inject actual values through your deployment secret store.
# Do not commit a populated copy. Use a private PostgreSQL connection with TLS as appropriate.
DB_URL=jdbc:postgresql://<private-host>:5432/<database>
DB_USERNAME=<runtime-role>
DB_PASSWORD=<secret>
# Optional dedicated migration role; see docs/database-setup.md.
SPRING_FLYWAY_USER=<migration-role>
SPRING_FLYWAY_PASSWORD=<secret>
SECURITY_OAUTH2_ISSUER_URI=https://<trusted-issuer>
SECURITY_OAUTH2_AUDIENCE=<api-audience>
# Optional: only when provider metadata discovery is unavailable.
# SECURITY_OAUTH2_JWK_SET_URI=https://<trusted-provider>/jwks
SECURITY_BOOTSTRAP_ENABLED=false
# The HTTPS reverse proxy connects to a private backend listener.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
